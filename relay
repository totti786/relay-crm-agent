def cmd_sync(args):
    """Diff an inbox snapshot into the store. Safe to run repeatedly (idempotent)."""
    raw = sys.stdin.read() if args.stdin else Path(args.file).read_text()
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError as e:
        sys.exit(f"error: invalid JSON — {e}")

    threads = payload.get("threads") or []
    if not threads:
        sys.exit("error: snapshot has no threads")

    cfg = load_config()
    conn = db()
    src = payload.get("source", args.source)
    report = {"source": src, "threads_seen": len(threads), "new_threads": [],
              "new_messages": [], "reopened": [], "unchanged": 0, "errors": []}

    for item in threads:
        tid = item.get("id")
        if not tid:
            report["errors"].append("thread without id skipped")
            continue
        a, c = item.get("account"), item.get("contact")
        ensure_party(conn, a, c)
        existing = one(conn, "select * from threads where id=?", (tid,))
        changed = existing is None

        if not existing:
            conn.execute(
                """insert into threads(id,account_id,contact_id,subject,channel,status,
                                       waiting_since,sla_due,assignee,summary,tags,updated_at)
                   values (?,?,?,?,?,?,?,?,?,?,?,?)""",
                (tid, (a or {}).get("id"), (c or {}).get("id"),
                 item.get("subject", "(no subject)"), item.get("channel", "email"),
                 item.get("status", "open"), None, item.get("sla_due"),
                 item.get("assignee"), item.get("summary"),
                 json.dumps(item.get("tags") or []), iso(now())),
            )
            report["new_threads"].append({
                "thread": tid, "subject": item.get("subject"),
                "contact": (c or {}).get("name"), "company": (a or {}).get("name"),
            })
            audit(conn, tid, "sync", f"New thread spotted via {src}")
        else:
            if item.get("subject"):
                conn.execute("update threads set subject=? where id=?", (item["subject"], tid))
            if item.get("assignee"):
                conn.execute("update threads set assignee=? where id=?", (item["assignee"], tid))
            if item.get("summary"):
                conn.execute("update threads set summary=? where id=?", (item["summary"], tid))
            if item.get("sla_due"):
                conn.execute("update threads set sla_due=? where id=?", (item["sla_due"], tid))
            if item.get("tags") is not None:
                conn.execute("update threads set tags=? where id=?", (json.dumps(item["tags"]), tid))

        added = [m for m in (item.get("messages") or []) if store_message(conn, tid, m)]
        if added:
            changed = True
            preview = " ".join((added[-1].get("body") or "").split())[:110]
            report["new_messages"].append({
                "thread": tid, "count": len(added),
                "contact": (c or {}).get("name") or existing.get("contact_id") if existing else (c or {}).get("name"),
                "preview": preview,
            })
            audit(conn, tid, "sync", f"{len(added)} new message(s) via {src}")

        last_in = one(conn, "select sent_at from messages where thread_id=? and direction='in' order by sent_at desc limit 1", (tid,))
        last_out = one(conn, "select sent_at from messages where thread_id=? and direction='out' order by sent_at desc limit 1", (tid,))
        in_ts = parse(last_in["sent_at"]) if last_in else None
        out_ts = parse(last_out["sent_at"]) if last_out else None

        if in_ts and (not out_ts or in_ts > out_ts):
            waited = last_in["sent_at"]
            sla = item.get("sla_due") or (existing or {}).get("sla_due")
            if not sla or (parse(sla) and parse(sla) < parse(waited)):
                sla = iso(parse(waited) + timedelta(hours=cfg.get("first_response_hours", 4)))
            if existing and existing.get("status") == "resolved":
                report["reopened"].append(tid)
                changed = True
                audit(conn, tid, "reopened", "Customer replied after resolution")
            conn.execute(
                "update threads set waiting_since=?, sla_due=?, status='open', updated_at=? where id=?",
                (waited, sla, iso(now()), tid),
            )
        elif out_ts and (not in_ts or out_ts > in_ts):
            conn.execute(
                "update threads set waiting_since=null, sla_due=null, updated_at=? where id=?",
                (iso(now()), tid),
            )
        else:
            pass

        if not changed:
            report["unchanged"] += 1

    conn.commit()

    if args.text:
        print(f"\n{BOLD}SYNC{RESET} {src} · {report['threads_seen']} threads · "
              f"{GREEN}{len(report['new_threads'])} new{RESET} · "
              f"{AMBER}{len(report['new_messages'])} with new messages{RESET} · "
              f"{len(report['reopened'])} reopened · {report['unchanged']} unchanged\n")
        for t in report["new_threads"]:
            print(f"  {GREEN}NEW{RESET}  {t['thread']} · {t.get('contact') or 'unknown'} "
                  f"{('(' + t['company'] + ')') if t.get('company') else ''} — {t.get('subject')}")
        for m in report["new_messages"]:
            print(f"  {AMBER}MSG{RESET}  {m['thread']} · {m['count']} new — {m['preview']}")
        for tid in report["reopened"]:
            print(f"  {AMBER}REOPEN{RESET} {tid} — customer replied after resolution")
        if not (report["new_threads"] or report["new_messages"] or report["reopened"]):
            print(f"  {DIM}no changes{RESET}")
        print()
    else:
        print(json.dumps(report, indent=2))


def cmd_alerts(args):
    """Machine- or human-readable monitoring feed. Exit 3 on breach with --fail-on-breach."""
    conn = db()
    cfg = load_config()
    horizon = now() + timedelta(hours=24)
    rows = many(
        conn,
        """select t.*, a.name as account, a.mrr, a.health, c.name as contact
           from threads t
           left join accounts a on a.id=t.account_id
           left join contacts c on c.id=t.contact_id
           where t.status='open'""",
    )
    waiting = [t for t in rows if t["waiting_since"]]
    breached = [t for t in waiting if t["sla_due"] and parse(t["sla_due"]) < now()]
    due_soon = [t for t in waiting if t["sla_due"] and now() <= parse(t["sla_due"]) <= now() + timedelta(hours=1)]
    unassigned = [t for t in waiting if not t["assignee"] or t["assignee"] == "Unassigned"]
    promises = [r for r in many(conn, "select * from commitments where status='open'")
                if parse(r["due_at"]) and parse(r["due_at"]) <= horizon]
    followups = [r for r in many(conn, "select * from tasks where status='open' and kind='followup'")
                 if parse(r["due_at"]) and parse(r["due_at"]) <= now()]
    overdue_promises = [p for p in promises if parse(p["due_at"]) < now()]

    out = {
        "at": iso(now()), "waiting": len(waiting), "breached": breached,
        "due_soon": due_soon, "unassigned": unassigned,
        "promises": promises, "followups": followups,
    }

    if args.json:
        print(json.dumps(out, indent=2))
    else:
        print(f"\n{BOLD}MONITOR{RESET}  {DIM}{now():%a %d %b · %H:%M} UTC{RESET}")
        print(f"{len(waiting)} awaiting reply · {RED if breached else DIM}{len(breached)} SLA breached{RESET} · "
              f"{len(unassigned)} unassigned · {len(promises)} promises due\n")
        for t in breached:
            late = (now() - parse(t["sla_due"])).total_seconds() / 60
            print(f"  {RED}BREACH{RESET} {t['contact']} · {t['account']} — "
                  f"{humanize(t['waiting_since'])} waiting — SLA {int(late)}m overdue")
        for t in due_soon:
            if t not in breached:
                print(f"  {AMBER}DUE{RESET}    {t['contact']} · {t['account']} — "
                      f"{humanize_future((parse(t['sla_due']) - now()).total_seconds())} left")
        for t in unassigned:
            if t not in breached and t not in due_soon:
                print(f"  {DIM}UNOWNED{RESET} {t['contact']} · {t['account']}")
        for p in promises:
            late = "overdue " if parse(p["due_at"]) < now() else ""
            print(f"  {AMBER}PROMISE{RESET} #{p['id']} {p['text']} — {late}{humanize(p['due_at'])}")
        for f in followups:
            print(f"  {DIM}FOLLOWUP{RESET} #{f['id']} {f['title']} — {humanize(f['due_at'])}")
        if not (breached or due_soon or unassigned or promises or followups):
            print(f"  {DIM}all clear{RESET}")
        print()

    if args.fail_on_breach and (breached or overdue_promises):
        sys.exit(3)


def cmd_serve(args):
    """Local webhook receiver: CRM pushes, Relay diffs, returns what changed."""
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    secret = args.secret or os.environ.get("RELAY_WEBHOOK_SECRET")
    if args.host not in ("127.0.0.1", "localhost", "::1") and not secret:
        sys.exit("error: refusing to bind a public interface without --secret")

    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    lock = DB_PATH.parent / "hook.lock"

    def fire_hook(report):
        """One run at a time; a second webhook does not stack a second agent."""
        if not args.on_change:
            return
        ids = [t["thread"] for t in report.get("new_threads", [])]
        ids += [m["thread"] for m in report.get("new_messages", [])]
        ids += report.get("reopened", [])
        ids = list(dict.fromkeys(ids))
        if lock.exists():
            if (now().timestamp() - lock.stat().st_mtime) > args.lock_seconds:
                lock.unlink(missing_ok=True)
            else:
                sys.stderr.write("webhook: hook already running, change stays queued\n")
                return
        try:
            fd = os.open(str(lock), os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            os.write(fd, str(os.getpid()).encode())
            os.close(fd)
        except FileExistsError:
            return
        env = os.environ.copy()
        env["RELAY_CHANGED_THREADS"] = ",".join(ids)
        env["RELAY_SOURCE"] = args.source
        if not args.allow_send:
            env["RELAY_DRAFT_ONLY"] = "1"
        script = f"{args.on_change}\nrm -f {shlex.quote(str(lock))}"
        subprocess.Popen(["sh", "-c", script], cwd=str(ROOT), env=env,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        sys.stderr.write(f"webhook: hook fired for {','.join(ids)}\n")

    class Handler(BaseHTTPRequestHandler):
        def _reply(self, code, payload):
            body = json.dumps(payload).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            if self.path == "/health":
                self._reply(200, {"ok": True, "db": str(DB_PATH)})
            else:
                self._reply(404, {"ok": False, "error": "not found"})

        def do_POST(self):
            if self.path != "/hook":
                return self._reply(404, {"ok": False, "error": "not found"})
            if secret and self.headers.get("X-Relay-Secret") != secret:
                return self._reply(401, {"ok": False, "error": "bad secret"})
            try:
                length = int(self.headers.get("Content-Length") or 0)
                payload = json.loads(self.rfile.read(length))
            except (ValueError, json.JSONDecodeError):
                return self._reply(400, {"ok": False, "error": "invalid json"})

            mode = "sync" if "threads" in payload else "ingest"
            proc = subprocess.run(
                [sys.executable, str(ROOT / "relay"), mode, "--stdin"],
                input=json.dumps(payload), text=True, capture_output=True,
                env=os.environ.copy(),
            )
            if proc.returncode != 0:
                return self._reply(422, {"ok": False,
                                         "error": (proc.stderr or proc.stdout).strip()[:800]})
            try:
                report = json.loads(proc.stdout)
            except json.JSONDecodeError:
                report = {"raw": proc.stdout}
            changed = bool(
                report.get("new_threads") or report.get("new_messages")
                or report.get("reopened")
                or (mode == "ingest" and report.get("messages_added"))
            )
            if changed:
                fire_hook(report)
            self._reply(200, {"ok": True, "mode": mode, "changed": changed, "report": report})

        def log_message(self, fmt, *a):
            sys.stderr.write("webhook " + (fmt % a) + "\n")

    print(f"relay webhook listening on http://{args.host}:{args.port}/hook\n"
          f"  db: {DB_PATH}\n  secret: {'set' if secret else 'none (loopback only)'}\n"
          f"  on-change: {args.on_change or 'none (poll relay alerts)'}\n"
