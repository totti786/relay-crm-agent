    for tid in evidence:
        must_thread(conn, tid)
    status = "active" if args.promote else "proposed"
    cur = conn.execute(
        """insert into lessons(scope,text,evidence,status,created_at,promoted_at,promoted_by)
           values (?,?,?,?,?,?,?)""",
        (args.scope, args.text, ",".join(evidence), status, iso(now()),
         iso(now()) if status == "active" else None,
         args.by if status == "active" else None),
    )
    audit(conn, evidence[0] if evidence else None, "lesson",
          f"Lesson #{cur.lastrowid} {status}: {args.text}")
    conn.commit()
    print(f"lesson #{cur.lastrowid} {status} [{args.scope}]")
    if status == "proposed":
        print(f"  promote: relay lesson promote {cur.lastrowid} --by you")


