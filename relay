        sys.exit(f"error: no draft {args.id}")
    conn.execute("update drafts set status='approved', approved_by=? where id=?", (args.by, args.id))
    audit(conn, row["thread_id"], "approved", f"Draft #{args.id} approved by {args.by}")
    conn.commit()
    print(f"draft #{args.id} approved by {args.by}")


def cmd_send(args):
    conn = db()
    t = must_thread(conn, args.id)

    if os.environ.get("RELAY_DRAFT_ONLY") == "1":
        sys.exit("error: RELAY_DRAFT_ONLY=1 — this run may draft but not send. "
                 "A human must approve and send.")

    if args.draft:
        row = one(conn, "select * from drafts where id=? and thread_id=?", (args.draft, args.id))
        if not row:
            sys.exit(f"error: draft {args.draft} does not belong to {args.id}")
        if row["status"] != "approved":
            sys.exit(
                f"error: draft #{args.draft} is {row['status']}, not approved.\n"
                f"       run: relay approve {args.draft} --by you"
            )
        body = row["body"]
        policy = {"decision": "sent_after_approval", "tier": load_config().get("autonomy"),
                  "reasons": [f"draft #{args.draft} approved by {row['approved_by']}"]}
    else:
        body = sys.stdin.read() if args.stdin else (args.text or "")
        body = body.strip()
        if not body:
            sys.exit("error: nothing to send (use --text, --stdin, or --draft)")
        policy = policy_check(conn, t, body)
        if policy["decision"] != "auto_send":
            print(f"error: policy requires approval before sending to {args.id}", file=sys.stderr)
            for reason in policy["reasons"] or ["autonomy policy"]:
                print(f"  - {reason}", file=sys.stderr)
            print(f"\n  next:\n"
                  f"    relay draft {args.id} --text \"...\"\n"
                  f"    relay approve <draft_id> --by you\n"
                  f"    relay send {args.id} --draft <draft_id>", file=sys.stderr)
            sys.exit(2)

    if not body.strip():
        sys.exit("error: nothing to send")

    last = one(conn, "select direction, body, sent_at from messages where thread_id=? order by sent_at desc, id desc limit 1", (args.id,))
    if last and last["direction"] == "out" and not args.force:
        sys.exit(
            f"error: last message on {args.id} is already outbound ({humanize(last['sent_at'])}).\n"
            "       Refusing to double-send. Pass --force if this really is a new message."
        )

    cfg = load_config()
    pacing = cfg.get("pacing") or {}
    if not args.urgent:
        min_gap = int(pacing.get("min_seconds_between_sends") or 0)
        max_hour = int(pacing.get("max_sends_per_hour") or 0)
        if min_gap:
            prev = one(conn, "select sent_at from messages where direction='out' order by sent_at desc limit 1")
            if prev and parse(prev["sent_at"]):
                elapsed = (now() - parse(prev["sent_at"])).total_seconds()
                if elapsed < min_gap:
                    sys.exit(
                        f"error: pacing — {int(min_gap - elapsed)}s before the next send "
                        f"({min_gap}s minimum). Use --urgent only for a live incident."
                    )
        if max_hour:
            recent = one(
                conn,
                "select count(*) c from messages where direction='out' and sent_at >= ?",
                (iso(now() - timedelta(hours=1)),),
            )["c"]
            if recent >= max_hour:
                sys.exit(
                    f"error: pacing — hourly cap reached ({recent}/{max_hour}). "
                    "Leave the rest queued; do not increase the cap to clear a backlog."
                )

    sent_at = iso(now())
    cur = conn.execute(
        "insert into messages(thread_id,direction,author,body,sent_at) values (?,?,?,?,?)",
        (args.id, "out", args.by, body, sent_at),
    )
    conn.execute(
        "update threads set waiting_since=null, sla_due=null, status='open', updated_at=? where id=?",
        (sent_at, args.id),
    )
    if args.draft:
        conn.execute("update drafts set status='sent' where id=?", (args.draft,))

    followup_due = iso(now() + timedelta(days=2))
    conn.execute(
        "insert into tasks(thread_id,kind,title,due_at,status) values (?,?,?,?,?)",
        (args.id, "followup", "Follow up if no reply", followup_due, "open"),
    )

    commitments = []
    if args.commit:
        due = parse_due(args.commit_due) or iso(now() + timedelta(days=1))
        c = conn.execute(
            "insert into commitments(thread_id,text,due_at,status,created_at) values (?,?,?,?,?)",
            (args.id, args.commit, due, "open", sent_at),
        )
        commitments.append({"id": c.lastrowid, "text": args.commit, "due_at": due})

    audit(conn, args.id, "sent", f"Reply sent by {args.by} ({len(body)} chars) — {policy['decision']}")
    conn.commit()

    print(json.dumps({
        "ok": True, "thread": args.id, "message_id": cur.lastrowid, "sent_at": sent_at,
        "policy": policy, "followup_due": followup_due, "commitments": commitments,
        "next": "relay due",
    }, indent=2))


