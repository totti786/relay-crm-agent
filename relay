# ---------------------------------------------------------------- time helpers
def now():
    return datetime.now(timezone.utc)


def iso(dt):
    return dt.astimezone(timezone.utc).replace(microsecond=0).isoformat()


def parse(ts):
    if not ts:
        return None
    try:
        return datetime.fromisoformat(ts.replace("Z", "+00:00"))
    except ValueError:
        return None


def humanize(ts):
    dt = parse(ts)
    if not dt:
        return "—"
    secs = (now() - dt).total_seconds()
    if secs < 0:
        return "in " + humanize_future(-secs)
    return humanize_future(secs) + " ago"


def humanize_future(secs):
    if secs < 3600:
        return f"{int(secs // 60)}m"
    if secs < 86400:
        return f"{int(secs // 3600)}h"
    return f"{int(secs // 86400)}d"


def parse_due(value):
    """'4h', '2d', or an ISO timestamp -> ISO string."""
    if not value:
        return None
    v = value.strip()
    try:
        if v.endswith("h"):
            return iso(now() + timedelta(hours=float(v[:-1])))
        if v.endswith("d"):
            return iso(now() + timedelta(days=float(v[:-1])))
        if v.endswith("m"):
            return iso(now() + timedelta(minutes=float(v[:-1])))
        return iso(datetime.fromisoformat(v.replace("Z", "+00:00")))
    except ValueError:
        sys.exit(f"error: cannot parse due date '{value}' (use 4h, 2d, or ISO)")


