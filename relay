def db():
    DB_PATH.parent.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(DB_PATH, timeout=30)
    conn.row_factory = sqlite3.Row
    conn.executescript(SCHEMA)
    return conn


def one(conn, sql, params=()):
    row = conn.execute(sql, params).fetchone()
    return dict(row) if row else None


def many(conn, sql, params=()):
    return [dict(r) for r in conn.execute(sql, params).fetchall()]


def audit(conn, thread_id, kind, detail):
    conn.execute(
        "insert into events(thread_id, kind, detail, created_at) values (?,?,?,?)",
        (thread_id, kind, detail, iso(now())),
    )


def fingerprint(thread_id, m):
    raw = "|".join([
        thread_id,
        m.get("direction", "in"),
        m.get("sent_at", ""),
        " ".join((m.get("body") or "").split()),
    ])
    return "fp:" + hashlib.sha1(raw.encode()).hexdigest()[:16]


def message_exists(conn, thread_id, m):
    ext = m.get("external_id") or fingerprint(thread_id, m)
    if one(conn, "select id from messages where external_id=?", (ext,)):
        return True
    return bool(one(
        conn,
        "select id from messages where thread_id=? and direction=? and sent_at=? and body=?",
        (thread_id, m.get("direction", "in"), m.get("sent_at"), m.get("body", "")),
    ))


def store_message(conn, thread_id, m):
    """Insert once. Returns True if the message was new."""
    if message_exists(conn, thread_id, m):
        return False
    conn.execute(
        "insert into messages(thread_id,direction,author,body,sent_at,external_id) values (?,?,?,?,?,?)",
        (thread_id, m.get("direction", "in"), m.get("author"), m.get("body", ""),
         m.get("sent_at") or iso(now()), m.get("external_id") or fingerprint(thread_id, m)),
    )
    return True


def ensure_party(conn, a=None, c=None):
    if a and a.get("id"):
        conn.execute(
            """insert into accounts(id,name,domain,plan,mrr,stage,owner,health,created_at)
               values (?,?,?,?,?,?,?,?,?)
               on conflict(id) do update set
                 name=excluded.name, domain=excluded.domain, plan=excluded.plan,
                 mrr=excluded.mrr, stage=excluded.stage, owner=excluded.owner, health=excluded.health""",
            (a["id"], a.get("name", a["id"]), a.get("domain"), a.get("plan"), a.get("mrr", 0),
             a.get("stage"), a.get("owner"), a.get("health", "ok"), iso(now())),
        )
    if c and c.get("id"):
        conn.execute(
            """insert into contacts(id,account_id,name,email,role,tz,sentiment)
               values (?,?,?,?,?,?,?)
               on conflict(id) do update set
                 account_id=excluded.account_id, name=excluded.name, email=excluded.email,
                 role=excluded.role, tz=excluded.tz, sentiment=excluded.sentiment""",
            (c["id"], a.get("id") if a else None, c.get("name", c["id"]), c.get("email"),
             c.get("role"), c.get("tz"), c.get("sentiment")),
        )


def thread_tags(row):
    try:
        return json.loads(row.get("tags") or "[]")
    except json.JSONDecodeError:
        return []


def must_thread(conn, tid):
    t = one(
        conn,
        """select t.*, a.name as account, a.mrr, a.stage as account_stage,
                  c.name as contact, c.email, c.tz, c.sentiment
           from threads t
           left join accounts a on a.id = t.account_id
           left join contacts c on c.id = t.contact_id
           where t.id = ?""",
        (tid,),
    )
    if not t:
        sys.exit(f"error: no thread '{tid}' (try: relay queue)")
    return t


# ---------------------------------------------------------------- policy
DEFAULT_CONFIG = {
    "autonomy": "approve",
    "daily_send_cap": 30,
    "reply_word_limit": 180,
    "vip_mrr_threshold": 5000,
    "risky_tags": ["billing", "security", "churn risk", "legal", "contract", "vip"],
    "approval_phrases": [],
}


def load_config():
    cfg = dict(DEFAULT_CONFIG)
    path = ROOT / "config.json"
    if path.exists():
        try:
            cfg.update(json.loads(path.read_text()))
        except json.JSONDecodeError:
            sys.exit("error: config.json is not valid JSON")
    return cfg


def policy_check(conn, t, body):
    """Return {decision, reasons, tier}. Reasons are what the human sees."""
    cfg = load_config()
    tier = cfg.get("autonomy", "approve")
    reasons = []

    words = len(body.split())
    if words > cfg.get("reply_word_limit", 180):
        reasons.append(f"{words} words exceeds {cfg['reply_word_limit']}-word limit")

    tags = {x.lower() for x in thread_tags(t)}
    hit_tags = sorted(tags & {x.lower() for x in cfg.get("risky_tags", [])})
    if hit_tags:
        reasons.append("sensitive thread: " + ", ".join(hit_tags))

    low = " ".join(body.lower().split())
    hits = [p for p in cfg.get("approval_phrases", []) if p in low]
    if hits:
        reasons.append("commitment language: " + ", ".join(hits[:3]))

    if (t.get("mrr") or 0) >= cfg.get("vip_mrr_threshold", 5000):
        reasons.append(f"VIP account (${t['mrr']:,.0f} MRR)")

    sent_today = one(
        conn,
        "select count(*) c from messages where direction='out' and author='agent' and sent_at >= ?",
        (iso(now().replace(hour=0, minute=0, second=0, microsecond=0)),),
    )["c"]
    if sent_today >= cfg.get("daily_send_cap", 30):
        reasons.append(f"daily cap reached ({sent_today}/{cfg['daily_send_cap']})")

    if tier == "suggest":
        return {"decision": "draft_only", "tier": tier,
                "reasons": ["autonomy=suggest: drafts only, never sends"] + reasons}
    if tier == "approve":
        return {"decision": "requires_approval", "tier": tier,
                "reasons": ["autonomy=approve: every send needs a human"] + reasons}
    return {
        "decision": "requires_approval" if reasons else "auto_send",
        "tier": tier, "reasons": reasons,
    }


def cmd_check(args):
    conn = db()
    t = must_thread(conn, args.id)
    body = sys.stdin.read() if args.stdin else (args.text or "")
    if not body.strip():
        sys.exit("error: provide --text or --stdin")
    res = policy_check(conn, t, body)
    res["thread"] = args.id
    res["words"] = len(body.split())
    print(json.dumps(res, indent=2))



# ---------------------------------------------------------------- scoring
def score(t):
    """Explainable priority: every point maps to a reason the agent can cite."""
    pts, reasons = 0.0, []
    mrr = t.get("mrr") or 0
    if mrr:
        add = min(30, mrr / 100)
        pts += add
        reasons.append(f"${mrr:,.0f} MRR")
    if t.get("waiting_since"):
        hours = (now() - parse(t["waiting_since"])).total_seconds() / 3600
        add = min(40, max(0, hours) * 2)
        pts += add
        reasons.append(f"waiting {humanize_future(hours * 3600)}")
    tags = [x.lower() for x in thread_tags(t)]
    if any(x in ("churn risk", "churn") for x in tags):
        pts += 14
        reasons.append("churn risk")
    if any(x in ("blocking", "security") for x in tags):
        pts += 12
        reasons.append("blocking")
    if (t.get("sentiment") or "").lower() in ("frustrated", "angry"):
        pts += 15
        reasons.append(f"sentiment {t['sentiment']}")
    if (t.get("account_stage") or "") in ("Negotiation", "Closed won"):
        pts += 5
    sla = parse(t.get("sla_due"))
    if sla:
        hours = (sla - now()).total_seconds() / 3600
        if hours < 0:
            pts += 25
            reasons.append(f"SLA breached {humanize_future(-hours * 3600)}")
        elif hours <= 4:
            pts += 12
            reasons.append(f"SLA in {humanize_future(hours * 3600)}")
    if (t.get("health") or "") == "at_risk":
        pts += 10
        reasons.append("account at risk")
    return round(pts, 1), reasons


