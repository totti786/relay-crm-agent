def cmd_ingest(args):
    """Upsert a normalised CRM payload (webhook, API poll, or export)."""
    raw = sys.stdin.read() if args.stdin else Path(args.file).read_text()
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError as e:
