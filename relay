def cmd_learn(_args):
    conn = db()
    fb = many(conn, "select * from feedback order by id desc")
    total = len(fb)
    avg = (sum(f["rating"] or 0 for f in fb) / total) if total else 0
    out_threads = one(conn, "select count(distinct thread_id) c from messages where direction='out'")["c"]
    answered = one(
        conn,
        """select count(distinct m.thread_id) c from messages m
           where m.direction='out' and exists (
             select 1 from messages i where i.thread_id=m.thread_id
             and i.direction='in' and i.sent_at > m.sent_at)""",
    )["c"]
    rate = round(100 * answered / out_threads) if out_threads else 0

    friction = {}
    for f in fb:
        if (f["rating"] or 5) <= 3 and f["tags"]:
            for tag in f["tags"].split(","):
                tag = tag.strip()
                if tag:
                    friction[tag] = friction.get(tag, 0) + 1

    active = one(conn, "select count(*) c from lessons where status='active'")["c"]
    proposed = many(conn, "select id,scope,text from lessons where status='proposed' order by id")

    print(f"\n{BOLD}LEARNING REPORT{RESET}  {DIM}{now():%a %d %b · %H:%M} UTC{RESET}")
    print(f"feedback {total}  ·  avg {avg:.1f}/5  ·  "
          f"human {sum(1 for f in fb if f['source']=='human')}  ·  "
          f"customer {sum(1 for f in fb if f['source']=='customer')}")
    print(f"reply → customer response: {rate}% ({answered}/{out_threads} outbound threads)")

    if friction:
        top = sorted(friction.items(), key=lambda x: -x[1])
        print(f"{BOLD}Friction tags{RESET}  " + " · ".join(f"{k} ×{v}" for k, v in top[:5]))
        for tag, count in top[:2]:
            if count >= 2:
                print(f"  {AMBER}{tag}{RESET} flagged {count}× — worth a lesson: "
                      f"relay lesson add --scope voice --text \"...\" --evidence <ids>")

    print(f"\n{BOLD}Lessons{RESET}  {active} active · {len(proposed)} proposed")
    for p in proposed:
        print(f"  ○ #{p['id']} [{p['scope']}] {p['text']}")
    print(f"{DIM}  promote: relay lesson promote <id> --by you{RESET}")
    print(f"{DIM}  active lessons load with: relay soul --with-lessons{RESET}\n")


