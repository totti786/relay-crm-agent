    conn.execute(
        """insert into threads(id,account_id,contact_id,subject,channel,status,waiting_since,
                               sla_due,assignee,summary,tags,updated_at)
           values (?,?,?,?,?,?,?,?,?,?,?,?)
           on conflict(id) do update set
             subject=excluded.subject, channel=excluded.channel, waiting_since=excluded.waiting_since,
             sla_due=excluded.sla_due, assignee=excluded.assignee, summary=excluded.summary,
             tags=excluded.tags, updated_at=excluded.updated_at""",
