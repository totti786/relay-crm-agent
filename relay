def cmd_doctor(args):
    problems, warnings, oks = [], [], []

    for doc in ("soul.md", "script.md", "PLAYBOOK.md"):
        (oks if (ROOT / doc).exists() else problems).append(f"{doc} present")

    cfg = load_config()
    if cfg.get("autonomy") in ("suggest", "approve", "auto"):
        oks.append(f"autonomy={cfg['autonomy']}")
    else:
        problems.append(f"invalid autonomy: {cfg.get('autonomy')}")
    if cfg.get("code_autonomy", "branch") in ("suggest", "branch", "main"):
        oks.append(f"code_autonomy={cfg.get('code_autonomy', 'branch')}")
    else:
        problems.append(f"invalid code_autonomy: {cfg.get('code_autonomy')}")
    if not cfg.get("pacing"):
        warnings.append("no pacing configured")

    conn = db()
    integrity = conn.execute("pragma integrity_check").fetchone()[0]
    (oks if integrity == "ok" else problems).append(f"db integrity: {integrity}")

    files = ([ROOT / "connectors" / f"{args.connector}.json"] if args.connector
             else sorted((ROOT / "connectors").glob("*.json")))
    if args.connector and not files[0].exists():
        problems.append(f"connector not found: {args.connector}")
    for path in files:
        try:
            data = json.loads(path.read_text())
        except json.JSONDecodeError as e:
            problems.append(f"{path.name}: invalid JSON ({e})")
            continue
        selectors = data.get("selectors") or {}
        missing = [
            logical for logical, alts in CONTROL_ALTERNATIVES.items()
            if not any(a in selectors for a in alts)
        ]
        if missing:
            problems.append(f"{path.name}: missing controls {', '.join(missing)}")
        else:
            oks.append(f"{path.name}: required controls present")
        if not data.get("urls"):
            warnings.append(f"{path.name}: no inbox URL")
        if not data.get("flows"):
            warnings.append(f"{path.name}: no flows")
        if not data.get("quirks"):
            warnings.append(f"{path.name}: no quirks documented")
        if data.get("verified") is False:
            warnings.append(f"{path.name}: unverified — dry-run before use")

    print(f"\n{BOLD}DOCTOR{RESET}  {DIM}{ROOT}{RESET}\n")
    for line in oks:
        print(f"  {GREEN}ok{RESET}    {line}")
    for line in warnings:
        print(f"  {AMBER}warn{RESET}  {line}")
    for line in problems:
        print(f"  {RED}fail{RESET}  {line}")
    print(f"\n{len(oks)} ok · {len(warnings)} warnings · {len(problems)} problems\n")
    if problems:
        sys.exit(1)


