def cmd_queue(args):
    conn = db()
    rows = many(
        conn,
        """select t.*, a.name as account, a.mrr, a.stage as account_stage, a.health,
                  c.name as contact, c.sentiment
           from threads t
           left join accounts a on a.id = t.account_id
           left join contacts c on c.id = t.contact_id
           where t.status = 'open'
           order by t.updated_at desc""",
    )
    ranked = []
    for r in rows:
        s, reasons = score(r)
        r["score"], r["reasons"] = s, reasons
        ranked.append(r)
    ranked.sort(key=lambda x: x["score"], reverse=True)
    ranked = ranked[: args.limit]

    if args.json:
        print(json.dumps([
            {
                "thread": r["id"], "subject": r["subject"], "contact": r["contact"],
                "company": r["account"], "mrr": r["mrr"], "stage": r["account_stage"],
                "assignee": r["assignee"], "waiting_since": r["waiting_since"],
                "sla_due": r["sla_due"], "score": r["score"], "reasons": r["reasons"],
            }
            for r in ranked
        ], indent=2))
        return

    print(f"\n{BOLD}Priority queue{RESET} {DIM}· {len(ranked)} open · ranked by revenue × wait × risk{RESET}\n")
    for i, r in enumerate(ranked, 1):
        print(f"{BOLD}{i}. {r['contact']}{RESET} {DIM}· {r['account']} · {r['id']}{RESET}")
        print(f"   {r['subject']}")
        print(f"   {DIM}score{RESET} {r['score']:.0f}   {DIM}waiting{RESET} "
              f"{humanize_future((now() - parse(r['waiting_since'])).total_seconds()) if r['waiting_since'] else '—'}"
              f"   {DIM}sla{RESET} {humanize(r['sla_due'])}   {DIM}{r['assignee']}{RESET}")
        print(f"   {AMBER}{' · '.join(r['reasons'])}{RESET}\n")


